{
  "name": "drive-proxy",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Comma-separated list of origins the Worker will serve.
  // Supports exact origins (https://example.com) and one wildcard prefix per entry (*.example.com).
  // Update with your Pages domain after the first deploy.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://tcc-player.tomtidswell.workers.dev,https://tcc-player.tottenhamcommunitychoir.org",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
